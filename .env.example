# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (email notifications) — optional, degrades gracefully if absent
RESEND_API_KEY=re_xxxxxxxxxxxx

# Site
NEXT_PUBLIC_SITE_URL=https://elegant-suite.com
NEXT_PUBLIC_WHATSAPP_NUMBER=923173330998

# MCP server auth — secret bearer token guarding /api/mcp (the Claude connector).
# Generate a strong random value, e.g.:  node -e "console.log('he_mcp_'+require('crypto').randomBytes(24).toString('hex'))"
# Keep it secret; anyone with this token can change room names/rates.
MCP_AUTH_TOKEN=he_mcp_replace_with_a_long_random_secret

# Password for the OAuth "Approve access" screen (/api/oauth/authorize) used
# when connecting Claude Desktop/mobile as a custom connector. Kept separate
# from MCP_AUTH_TOKEN so it's short enough to type on a phone. Pick something
# memorable but not guessable — the endpoint rate-limits repeated failures.
MCP_OWNER_PASSWORD=replace_with_a_password_you_can_type_on_mobile

# Meta Conversions API — server-side Lead/Purchase events (lib/metaCapi.ts).
# Pixel ID + a System User access token from Meta Events Manager.
META_PIXEL_ID=your-pixel-id
META_ACCESS_TOKEN=your-capi-access-token
# Optional — only set while testing in Events Manager's Test Events tab.
META_TEST_EVENT_CODE=

# GA4 Measurement Protocol — server-side "booking_submitted" event fired
# when a booking is marked Completed (lib/ga4Mp.ts), so Google Ads' imported
# Purchase conversion reflects stays that actually happened, at their true
# final value. Measurement ID is public (same as the GTM "Google tag");
# the API secret is created in GA4 Admin > Data Streams > your stream >
# Measurement Protocol API secrets — keep it private.
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
GA4_API_SECRET=your-measurement-protocol-api-secret
# Optional — 'true' routes events to GA4's validation-only debug endpoint
# instead of recording real data. Use while verifying a new API secret,
# then unset so events start counting for real.
GA4_MP_DEBUG=

# Admin (set this in Supabase Auth, not here — just reminder)
# Create an admin user in Supabase Authentication dashboard
# Then add their user_id to admin_users table
